{
  "manifest_version": 3,
  "name": "O'lyapmiz",
  "version": "1.0.0",
  "description": "Memento mori on every new tab — the Yil year calendar and Umr life-in-weeks view from the O'lyapmiz app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "O'lyapmiz"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ]
}
